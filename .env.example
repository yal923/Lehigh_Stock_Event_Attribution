# Flask / app
SECRET_KEY=change-me
DATABASE_URL=sqlite:///sa41.db

# Optional news providers for pipeline runs.
# RSS retrieval is enabled by default and does not need an API key.
ENABLE_GOOGLE_RSS=true
STOCKNEWS_API_KEY=
FINNHUB_API_KEY=

# AI Explanation provider.
# Supported providers: openai, anthropic, gemini.
# AI_MODEL is optional; each provider has a project default when omitted.
AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Episode defaults
ENABLE_SIGNAL_EPISODE_V2=true
DEFAULT_EPISODE_HORIZON_N=3
DEFAULT_EPISODE_THRESHOLD=0.05
DEFAULT_EPISODE_MERGE_GAP_DAYS=2
DEFAULT_EPISODE_LOOKBACK_DAYS=365
